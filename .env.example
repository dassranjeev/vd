# ─────────────────────────────────────────────────────────────
# REQUIRED — Postgres connection string
# Works with Neon, Vercel Postgres, Supabase, Railway, or local PG.
# Use the *pooled* connection string when your provider offers one.
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ─────────────────────────────────────────────────────────────
# REQUIRED — signs the admin session cookie.
# Generate one with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────
AUTH_SECRET="replace-me-with-a-long-random-string"

# ─────────────────────────────────────────────────────────────
# Bootstrap admin account, created by `npm run db:setup`
# ─────────────────────────────────────────────────────────────
ADMIN_EMAIL="vdascolor@gmail.com"
ADMIN_PASSWORD="change-this-immediately"
ADMIN_NAME="Vivek Das"

# ─────────────────────────────────────────────────────────────
# OPTIONAL — Vercel Blob, powers the Media Library uploads.
# Create a Blob store in the Vercel dashboard; the token is
# injected automatically on Vercel. Only needed for local dev.
# Without it, the Media Library falls back to pasting URLs.
# ─────────────────────────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=""

# ─────────────────────────────────────────────────────────────
# OPTIONAL — public site URL, used for canonical tags + sitemap.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://vivekdas.com"

# ─────────────────────────────────────────────────────────────
# OPTIONAL — protects POST /api/admin/setup, which lets you
# initialise the schema + seed data against a remote database
# without running anything locally.
# ─────────────────────────────────────────────────────────────
SETUP_SECRET=""
